# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Which model the agents use by default.
#   claude-sonnet-5  -> fast + cheap, the right default for automation
#   claude-opus-5    -> smarter, slower, pricier; for hard reasoning jobs
AGENT_MODEL=claude-sonnet-5

# Every file tool is locked to this directory. Agents cannot read or write
# outside of it. Relative paths are resolved against the project root.
AGENT_WORKSPACE=./workspace

# When true, tools that would change something on disk only *describe* what
# they would do instead of doing it. Start with true until you trust a run.
AGENT_DRY_RUN=true

# Hard ceiling on how many think->act cycles a single agent run may take.
# Protects you from a runaway loop burning tokens.
AGENT_MAX_STEPS=25

# --- Optional: delivering results (toolkits/notify.py) ---------------------
# Agents can only post to destinations you configure here. The model chooses
# a *name*, never a URL, so nothing it reads in a document can redirect it.

# Slack or Discord incoming webhook, used by `send_webhook` as "default".
# WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Extra named destinations. `send_webhook(destination="alerts")` looks up
# WEBHOOK_URL_ALERTS.
# WEBHOOK_URL_ALERTS=https://hooks.slack.com/services/...

# Email delivery for `send_email`. All four are required for it to work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=an-app-specific-password-not-your-real-one
# SMTP_FROM=you@example.com
# SMTP_TO=you@example.com
