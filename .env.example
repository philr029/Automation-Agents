# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Which model the agents use by default.
#   claude-sonnet-5  -> fast + cheap, the right default for automation
#   claude-opus-5    -> smarter, slower, pricier; for hard reasoning jobs
AGENT_MODEL=claude-sonnet-5

# Every file tool is locked to this directory. Agents cannot read or write
# outside of it. Relative paths are resolved against the project root.
AGENT_WORKSPACE=./workspace

# When true, tools that would change something on disk only *describe* what
# they would do instead of doing it. Start with true until you trust a run.
AGENT_DRY_RUN=true

# Hard ceiling on how many think->act cycles a single agent run may take.
# Protects you from a runaway loop burning tokens.
AGENT_MAX_STEPS=25
